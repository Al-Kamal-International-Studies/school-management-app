# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

# Safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY SECRET — never expose this to the browser or commit it.
# Used only in server actions (e.g. admin creating teacher/student accounts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app, used to build password-reset email links.
# For local dev this is fine as-is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (free, standards-based — no third-party push service or paid
# subscription). Generate your own pair with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# SERVER-ONLY SECRET — native push (APNs/FCM) for the Capacitor app shell,
# see src/lib/push/sendNative.ts's own doc comment. Not required for the
# web app to work at all — leave unset until a Firebase project exists
# (App Store plan step 3/4, HANDOVER.md). The entire contents of the
# service-account JSON file downloaded from Firebase Console -> Project
# Settings -> Service Accounts, as one single-line env var string.
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
